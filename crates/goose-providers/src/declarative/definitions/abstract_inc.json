      "currency": "USD",
      "supports_vision": false
    },
    {
      "name": "kimi-k3:superfast",
      "context_limit": 262144,
      "input_token_cost": 0.000003,
      "output_token_cost": 0.00001275,
      "cache_read_token_cost": 0.0000003,
      "currency": "USD",
      "supports_vision": false
    },
    {
      "name": "deepseek-v4-flash:superfast",
      "context_limit": 262144,
      "input_token_cost": 0.0000001,
      "output_token_cost": 0.00000025,
      "cache_read_token_cost": 0.00000005,
      "currency": "USD",
      "supports_vision": false
    }
  ],
  "dynamic_models": false,
  "skip_canonical_filtering": true,
  "supports_streaming": false,
  "model_doc_link": "https://abstract.inc/docs",
  "setup_steps": [
